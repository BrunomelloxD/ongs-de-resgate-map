# Copy to apps/api/.env. Validated on startup (src/common/config/env.schema.ts).

# ---------- App ----------
APP_NAME="<nome-do-projeto>"
NODE_ENV=development
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated
CORS_ORIGIN=http://localhost:3000

# ---------- Rate limit ----------
# Window in ms and max requests per IP within it
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ---------- Prisma ----------
# Local runs (dev, tests, migrations). Must match the root .env credentials.
# Docker Compose overrides it with host "database".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/<nome-do-projeto>"

# ---------- Storage (S3-compatible) ----------
# Dev values point to MinIO from docker-compose.yml. In production, use the
# hosted bucket and keep the real keys out of the repository.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=animal-helper-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# true for MinIO; false for hosted buckets
S3_FORCE_PATH_STYLE=true

# ---------- Mail ----------
# Mailpit in dev (UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Animal Helper <nao-responda@example.com>"
# Public address of the web app (links in e-mails)
WEB_URL=http://localhost:3000

# ---------- Secrets (fake values; generate real ones with `openssl rand -base64 48`) ----------
# Same value in apps/web/.env. Sent by the web as X-Internal-Token.
INTERNAL_API_TOKEN=dev-internal-token-0000000000000000000000
# Key for hashing visitor IPs
IP_HASH_SECRET=dev-ip-hash-secret-000000000000000000000000

# ---------- Geocoding ----------
NOMINATIM_URL=https://nominatim.openstreetmap.org
# The public Nominatim requires a User-Agent with a contact
NOMINATIM_USER_AGENT="animal-helper/0.1 (contato@example.com)"

# ---------- Demo mode ----------
DEMO_MODE=true
# Days until a signed-up NGO is deleted (0 or more)
DEMO_RETENTION_DAYS=7
DEMO_MAX_NGOS=30
DEMO_SIGNUPS_PER_IP_PER_DAY=2
DEMO_MAX_ANIMALS_PER_NGO=10
DEMO_MAX_IMAGES_PER_ANIMAL=3
DEMO_MAX_UPLOAD_MB=5
DEMO_MAX_STORAGE_MB=500
