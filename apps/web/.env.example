# Copy to apps/web/.env. Server-only variables, validated in src/lib/env.ts.

# Docker Compose overrides this with http://api:<API_PORT>.
API_URL=http://localhost:3333

# Must equal INTERNAL_API_TOKEN in apps/api/.env (32+ characters). Sent as X-Internal-Token.
INTERNAL_API_TOKEN=dev-internal-token-0000000000000000000000

# Public address of the web app.
PUBLIC_WEB_URL=http://localhost:3000

# Map tiles: template URL and the attribution shown on the map.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors

# Upload limit in MB; must match the api (DEMO_MAX_UPLOAD_MB with the demo on, 10 otherwise).
# Read at build time for serverActions.bodySizeLimit (MAX_UPLOAD_MB + 1).
MAX_UPLOAD_MB=5
