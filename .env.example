# Docker Compose only. App variables live in apps/<app>/.env.

# ---------- Postgres ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=<nome-do-projeto>
# Host port; change it if 5432 is taken.
POSTGRES_PORT=5432

# ---------- Host ports ----------
WEB_PORT=3000
API_PORT=3333
# Optional profiles (mock, docs)
MOCK_API_PORT=4010
STORYBOOK_PORT=6006

# ---------- Dev storage and mail (MinIO, Mailpit) ----------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=animal-helper-dev
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
