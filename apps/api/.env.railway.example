# Bucket hospedado para o `make dev-railway`. Copie para apps/api/.env.railway
# (fora do git) e preencha com as credenciais de um bucket só de desenvolvimento.
# Nunca use aqui o bucket de produção: o banco local não conhece os objetos dele.
S3_ENDPOINT=https://exemplo.storageapi.dev
S3_REGION=auto
S3_BUCKET=animal-helper-dev
S3_ACCESS_KEY_ID=troque-pela-chave-de-acesso
S3_SECRET_ACCESS_KEY=troque-pela-chave-secreta
S3_FORCE_PATH_STYLE=true
